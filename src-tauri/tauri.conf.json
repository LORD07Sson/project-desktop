{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Desktop",
  "version": "0.4.2",
  "identifier": "com.project.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Project Desktop",
        "width": 1180,
        "height": 760,
        "minWidth": 760,
        "minHeight": 480,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://minitg.shitstudent.com:8443; font-src 'self'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Клиент студии дубляжа PROJECT",
    "longDescription": "Десктоп-клиент студии: список отчётов, массовые операции, локальный QC звука, трей с уведомлениями."
  }
}
